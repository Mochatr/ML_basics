{
  "name": "Multi-Repo Development",
  "customizations": {
    "codespaces": {
      "repositories": {
        "introduction_to_AI_agents": {
          "permissions": {
            "contents": "write"
          }
        },
        "python_for_AI": {
          "permissions": {
            "contents": "write"
          }
        }
      }
    }
  },
  "postCreateCommand": "cd /workspaces && git clone https://github.com/Mochatr/introduction_to_AI_agents.git && git clone https://github.com/Mochatr/python_for_AI.git"
}
